# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (required) ---------------------------------------------------
# From your Supabase project: Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key — server-only, NEVER exposed to the browser. Required for
# admin operations, the PM-generation cron, and sending notifications (it looks
# up recipients bypassing RLS). Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site / auth -----------------------------------------------------------
# Absolute base URL of the deployment, used to build links in emails and auth
# redirects. On Vercel, VERCEL_URL is used as a fallback if this is unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated list of admin email addresses. Used to bootstrap the first
# super-admin and as a fallback recipient list for notifications.
ADMIN_EMAILS=you@example.com

# --- Cron (Vercel) ---------------------------------------------------------
# Shared secret that the daily PM-generation cron route checks. Set the same
# value in the Vercel project so the scheduled request is authenticated.
CRON_SECRET=generate-a-long-random-string

# --- Email via Resend (optional) -------------------------------------------
# If RESEND_API_KEY is unset, the app runs fine and simply skips sending email.
RESEND_API_KEY=
# From address for outgoing mail, on a domain verified in Resend (the domain
# needs no mailbox). Defaults to Resend's test sender, onboarding@resend.dev,
# which only delivers to the Resend account's own email.
MAIL_FROM=Omaha Lightning Basketball <registration@yourdomain.org>
# Where replies to the site's emails go. Defaults to the club's Gmail
# (LightningBasketballOmaha@gmail.com). Contact form emails reply to the
# visitor instead.
MAIL_REPLY_TO=
# Inbox for the public site's Contact form. Defaults to the address shown on
# the Contact page (LightningBasketballOmaha@gmail.com). Without RESEND_API_KEY
# the form tells visitors to email that address instead.
CONTACT_EMAIL=

# --- Slack (optional) ------------------------------------------------------
# Nothing about the Slack workspace is in the code. Each site runs its own
# Slack app (with its own bot name and icon) in its own workspace and points
# the portal at it with the vars below. To set one up, print an app manifest
# with this site's URLs filled in:
#   npm run slack-app-manifest -- --name "Bot Name" --site-url https://your-site.example
# then api.slack.com/apps -> Create New App -> From a manifest -> pick the
# workspace -> paste it. Upload the bot's icon under Basic Information ->
# Display Information (a manifest can't carry one), then Install to
# Workspace. The script prints the remaining steps.
#
# Notifications: if either var is unset, the app runs fine and simply skips
# Slack messages. The token is OAuth & Permissions -> "Bot User OAuth Token".
# Invite the bot (/invite @BotName) to the notify channel, and to any channel
# a procedure posts to or the archive syncs.
SLACK_BOT_TOKEN=
# The target channel's ID (NOT its name), e.g. C0123ABC4. In Slack: open the
# channel -> View channel details -> ID is at the bottom.
SLACK_NOTIFY_CHANNEL_ID=
# Two-way Slack (thread replies -> task comments): the app's Signing Secret
# from api.slack.com/apps -> Basic Information. /api/slack/events rejects
# everything without it, Slack's own Request URL check included -- set it and
# redeploy before verifying the Events Request URL in the app's settings.
SLACK_SIGNING_SECRET=

# Slack Channel Archive (/portal/slack-archive): reuses SLACK_BOT_TOKEN
# above; the manifest already includes the scopes it needs (files:read for
# attachments, channels:read / groups:read for mirroring private-channel
# membership). Channels are registered in-app, not via env var.
#
# The exceptions page's "Compress large files now" button fires the
# slack-archive-compress GitHub Actions workflow via GitHub's REST API (that
# workflow does the actual ffmpeg work -- this site only triggers/polls it).
# The photo album's "Make previews now" button does the same for the
# slack-archive-thumbnails workflow, which makes the album's grid previews.
# Needs a token with permission to dispatch workflows and read run status on
# this site's repo: a fine-grained PAT scoped to just that repo with
# "Actions: Read and write" is enough. Without this set, clicking the button
# just returns a clear "not configured" error and the "last run" status is
# omitted -- everything else about the archive still works, and the
# workflow still runs on its own nightly schedule regardless. Those
# workflows read NEXT_PUBLIC_SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY and
# SLACK_BOT_TOKEN from the repo's GitHub Actions secrets.
GITHUB_ACTIONS_TOKEN=
# The repo those workflows live in, as owner/name. Optional on Vercel, where
# it defaults to the GitHub repo the deployment was built from. Runs start on
# GITHUB_ACTIONS_REF (default main).
GITHUB_ACTIONS_REPO=
GITHUB_ACTIONS_REF=

# --- "Continue with Slack" sign-in (optional) ------------------------------
# Lets members sign in with their Slack account. The Slack OIDC provider itself
# is configured in the Supabase dashboard (Authentication -> Providers -> Slack
# (OIDC)) with the Client ID and Client Secret from the Slack app's Basic
# Information page, NOT here. This one var gates *auto-approval*: a sign-in
# whose Slack workspace (team) id matches SLACK_TEAM_ID is approved instantly
# (no review); any other sign-in still lands pending. Leave unset to require
# review for everyone. Find the id by opening the workspace in a browser and
# copying the "T…" code from the URL (app.slack.com/client/T…/…), or run
# Slack's auth.test with the bot token.
SLACK_TEAM_ID=

# --- Slack DMs to families (optional) ---------------------------------------
# Lets members with the Slack DMs permission (Settings -> Members -> Manages:
# Slack DMs) message families from the Directory as themselves, one Slack DM
# per person. Each sender taps "Connect Slack" once (/api/slack/connect).
#
# This is a SECOND Slack app, not the bot's: Slack won't install one app that
# asks for the sign-in scopes (openid, email, profile) together with other
# user scopes ("Invalid permissions requested"). Print its manifest with
#   npm run slack-app-manifest -- --dm --name "Lightning DMs" --site-url https://<site>
# then api.slack.com/apps -> Create New App -> From a manifest -> paste.
# Each sender authorizes it with Connect Slack (approve installing it if asked).
# Copy its Basic Information -> App Credentials -> Client ID and Client
# Secret here. SLACK_TEAM_ID above, when set, keeps connections to the club's
# workspace. Without these, the Slack families window says Slack DMs aren't
# set up.
SLACK_DM_CLIENT_ID=
SLACK_DM_CLIENT_SECRET=

# --- Dave's Idea / ReelNotes recordings (optional) --------------------------
# LEGACY: only needed to hard-delete recordings made before 2026-06 (those
# lived in Vercel Blob). New recordings go to the private reel-notes-audio
# bucket in Supabase Storage, which uses the service-role key above.
BLOB_READ_WRITE_TOKEN=
# Transcription. Without the key, recordings save but stay in 'transcribing'.
ASSEMBLYAI_API_KEY=
# Shared secret echoed back by AssemblyAI on the transcription webhook. When
# set, the webhook route rejects calls without the matching header. Generate a
# long random string and set it on Vercel too.
ASSEMBLYAI_WEBHOOK_SECRET=
# Action-item extraction calls Claude through the Vercel AI Gateway. On Vercel
# this authenticates automatically via OIDC; locally set a gateway API key.
AI_GATEWAY_API_KEY=
