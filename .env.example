# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (required) ---------------------------------------------------
# From your Supabase project: Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key — server-only, NEVER exposed to the browser. Required for
# admin operations, the PM-generation cron, and sending notifications (it looks
# up recipients bypassing RLS). Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site / auth -----------------------------------------------------------
# Absolute base URL of the deployment, used to build links in emails and auth
# redirects. On Vercel, VERCEL_URL is used as a fallback if this is unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated list of admin email addresses. Used to bootstrap the first
# super-admin and as a fallback recipient list for notifications.
ADMIN_EMAILS=you@example.com

# --- Cron (Vercel) ---------------------------------------------------------
# Shared secret that the daily PM-generation cron route checks. Set the same
# value in the Vercel project so the scheduled request is authenticated.
CRON_SECRET=generate-a-long-random-string

# --- Email via Resend (optional) -------------------------------------------
# If RESEND_API_KEY is unset, the app runs fine and simply skips sending email.
RESEND_API_KEY=
# From address for outgoing mail. Defaults to "MCC Portal <onboarding@resend.dev>".
MAIL_FROM=MCC Portal <notifications@yourdomain.org>

# --- Slack notifications (optional) ----------------------------------------
# If either var is unset, the app runs fine and simply skips Slack messages.
# From a Slack app installed in the mccsaints workspace (api.slack.com/apps):
# OAuth & Permissions -> Bot Token Scopes -> add chat:write, then Install and
# copy the "Bot User OAuth Token". Invite the bot to the notify channel.
SLACK_BOT_TOKEN=
# The target channel's ID (NOT its name), e.g. C0123ABC4. In Slack: open the
# channel -> View channel details -> ID is at the bottom.
SLACK_NOTIFY_CHANNEL_ID=
# Two-way Slack (thread replies -> task comments): the app's Signing Secret
# from api.slack.com/apps -> Basic Information. /api/slack/events rejects
# everything without it.
SLACK_SIGNING_SECRET=

# --- Dave's Idea / ReelNotes recordings (optional) --------------------------
# LEGACY: only needed to hard-delete recordings made before 2026-06 (those
# lived in Vercel Blob). New recordings go to the private reel-notes-audio
# bucket in Supabase Storage, which uses the service-role key above.
BLOB_READ_WRITE_TOKEN=
# Transcription. Without the key, recordings save but stay in 'transcribing'.
ASSEMBLYAI_API_KEY=
# Shared secret echoed back by AssemblyAI on the transcription webhook. When
# set, the webhook route rejects calls without the matching header. Generate a
# long random string and set it on Vercel too.
ASSEMBLYAI_WEBHOOK_SECRET=
# Action-item extraction calls Claude through the Vercel AI Gateway. On Vercel
# this authenticates automatically via OIDC; locally set a gateway API key.
AI_GATEWAY_API_KEY=
