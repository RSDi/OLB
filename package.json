{
  "name": "millard-community-church",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "import-directory": "tsx --env-file=.env.local scripts/import-directory.ts",
    "slack-archive-backfill": "tsx --env-file=.env.local scripts/slack-archive-backfill.ts",
    "slack-archive-compress-large-files": "tsx --env-file=.env.local scripts/slack-archive-compress-large-files.ts",
    "slack-archive-emoji-map": "tsx scripts/slack-archive-generate-emoji-map.ts",
    "test": "node --test \"tests/**/*.test.ts\" \"packages/**/*.test.ts\""
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@vercel/blob": "^2.4.0",
    "ai": "^6.0.192",
    "next": "16.2.6",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.12.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "emoji-datasource": "^16.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "exceljs": "^4.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5"
  }
}
